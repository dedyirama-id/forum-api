{
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "semi": "error",
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "max-len": "off",
    "no-console": "off",
    "linebreak-style": ["error", "unix"]
  }
}
